{
  "name": "Enterprise Agentic RAG Course (Codespaces)",
  "image": "hukimartia/agentic-rag-lab:latest",

  // 1. 포트 자동 포워딩 설정
  "forwardPorts": [8080, 8000, 8010, 8888],

  "portsAttributes": {
    "8080": {
      "label": "Chainlit Chat UI",
      "onAutoForward": "openBrowser",
      "elevateIfNeeded": true
    },
    "8000": {
      "label": "FastAPI Backend API",
      "onAutoForward": "silent"
    },
    "8010": {
      "label": "Enterprise RAG FastMCP Server",
      "onAutoForward": "silent"
    },
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "notify",
      "elevateIfNeeded": true
    }
  },

  // 2. VS Code 필수 확장 도구 및 설정
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.askForKernelRestart": false
      }
    }
  },

  // 3. 컨테이너 생성 직후 초기화 (.env 자동 세팅만 수행 — 의존성은 이미지에 사전 설치됨)
  "postCreateCommand": "if [ ! -f .env ] && [ -f .env.example ]; then cp .env.example .env && echo '📄 .env 파일이 생성되었습니다. GOOGLE_API_KEY / OPENAI_API_KEY를 입력하세요.'; fi && echo '🚀 Enterprise Agentic RAG Environment is Ready!'"
}
