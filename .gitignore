# ===============================================================================
# agent-harness-lab .gitignore
# ===============================================================================

# ── Byte-compiled / optimized / DLL files ──
__pycache__/
*.py[cod]
*$py.class

# ── Environments & Secrets ──
.env
.venv
venv/
ENV/
env/

# ── Databases & Caching ──
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# Allow pre-built RAG databases for distribution (Chroma, GraphRAG, etc.)
!app/database/**
!app/database/**/*
app/database/checkpoints.db*
app/database/chainlit_history.db*
app/database/chat_history.db*

# ── Logs ──
*.log

# ── Task tracking & State ──
task.md
task_state.json
plan_state.json
TASK.md

# ── Jupyter Notebook ──
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── IDEs ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Test / Experiment residues ──
samples/
scratch/
sandbox/
output/

# ── Chainlit runtime files ──
.files/

# ── Agent artifacts (에이전트가 생성하는 런타임 산출물) ──
artifacts/eval_runs/
artifacts/eval_logs/
artifacts/normalized/
artifacts/knowledge_graph.html
artifacts/*.log
artifacts/runs/
artifacts/data/
artifacts/screenshots/
artifacts/temporary/
artifacts/reports/
artifacts/charts/
artifacts/analyst_test/

# ── Browser automation temp files ──
bu_cdp_*/

# ── OS generated files ──
.DS_Store
Thumbs.db
desktop.ini
